<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<!-- =========== Bases =========== -->
	<ThingDef Name="DisabledBase_MiscRobots" Abstract="True">
		<thingClass>AIRobot.X2_AIRobot_disabled</thingClass>
		<techLevel>Industrial</techLevel>
		<category>Building</category>
		<minifiedDef>MinifiedThing</minifiedDef>
		<altitudeLayer>Item</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<tradeability>Sellable</tradeability>
		<smeltable>true</smeltable>
		<fillPercent>0.4</fillPercent>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<MarketValue>25</MarketValue>
			<Flammability>1</Flammability>
			<Beauty>-10</Beauty>
			<SellPriceFactor>0.30</SellPriceFactor>
		</statBases>
		<selectable>true</selectable>
		<pathCost>55</pathCost>
		<pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
		<randomizeRotationOnSpawn>true</randomizeRotationOnSpawn>
		<tradeNeverStack>true</tradeNeverStack>
		<stackLimit>1</stackLimit>
		<useHitPoints>true</useHitPoints>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<alwaysHaulable>true</alwaysHaulable>
		<tickerType>Normal</tickerType>
		<!-- for CompForbiddable -->
		<drawerType>RealtimeOnly</drawerType>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<thingCategories>
			<li>Robots</li>
		</thingCategories>
	</ThingDef>
	
	<ThingDef Name="DisabledBase" ParentName="DisabledBase_MiscRobots" Abstract="True">
		<selectable>true</selectable>
	</ThingDef>
	
	<!--******** META - TIERS ********-->
	<ThingDef Abstract="True" Name="AIRobot_Disabled" ParentName="DisabledBase">
		<thingClass>AIRobot.X2_AIRobot_disabled</thingClass>
		<soundDrop>ChunkRock_Drop</soundDrop>
	</ThingDef>
	
	<ThingDef Abstract="True" Name="AIRobot_Disabled_I" ParentName="AIRobot_Disabled">
		<description>This is the sad end of a bot. It's no longer useful and needs heavy repairs or dismantling.</description>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.9</drawSize>
			<onGroundRandomRotateAngle>45</onGroundRandomRotateAngle>
		</graphicData>
		<statBases>
			<WorkToMake>500</WorkToMake>
			<Mass>5</Mass>
		</statBases>
		<costList>
			<Steel>35</Steel>
			<Plasteel>5</Plasteel>
			<Gold>3</Gold>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
	</ThingDef>

	<!--******** INHERET ********-->
	<ThingDef ParentName="AIRobot_Disabled_I">
		<defName>AIRobot_GardenerBot_disabled</defName>
		<label>Gardener Bot (disabled)</label>
		<graphicData>
			<texPath>Things/AIRobot/GardenerBot_north</texPath>
		</graphicData>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Disabled_I">
		<defName>AIRobot_CraftingBot_disabled</defName>
		<label>Crafting Bot (disabled)</label>
		<graphicData>
			<texPath>Things/AIRobot/CraftingBot_north</texPath>
		</graphicData>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Disabled_I">
		<defName>AIRobot_MiningBot_disabled</defName>
		<label>Mining Bot (disabled)</label>
		<graphicData>
			<texPath>Things/AIRobot/MiningBot_north</texPath>
		</graphicData>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Disabled_I">
		<defName>AIRobot_ConstructionBot_disabled</defName>
		<label>Construction Bot (disabled)</label>
		<graphicData>
			<texPath>Things/AIRobot/ConstructionBot_north</texPath>
		</graphicData>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Disabled_I">
		<defName>AIRobot_MedBot_disabled</defName>
		<label>Med Bot (disabled)</label>
		<graphicData>
			<texPath>Things/AIRobot/MedBot_north</texPath>
		</graphicData>
	</ThingDef>
</Defs>
