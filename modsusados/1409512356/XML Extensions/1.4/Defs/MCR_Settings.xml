<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<XmlExtensions.SettingsMenuDef>
		<defName>MiscCraftableRobotsSettings</defName> <!--Can be anything unique with no periods-->
		<modId>leion247658MiscVHCraftableHRobots</modId> <!--MUST be the same as the one entered earlier-->    
		<label>Misc. Craftable Robots</label> <!-- This is what displays as your mod's name-->    
		<settings> <!--This is where you define what settings are in the settings menu-->
			<li Class="XmlExtensions.Setting.Text">
				<text>Misc. Craftable Robots Settings</text>
				<font>Medium</font>
				<anchor>Middle</anchor>
				<tKey>MiscCraftableRobotsSettingsTitle</tKey>
			</li>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.SetColor"><color>(187,0,0)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>For any changed settings to take effect the game must be restarted.</text>
				<font>Medium</font>
				<anchor>Middle</anchor>
				<tKey>MCRWarning</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.Text">
				<text>Skill Levels</text>
				<anchor>Middle</anchor>
				<tKey>MCRSkillLevelSettingsTitle</tKey>
			</li>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.ResetSettings">
				<label>Reset Bot Skill Settings</label>
				<confirm>false</confirm>
				<keys>
					<li>MCRBotLevelVariable1</li>
					<li>MCRBotLevelVariable2</li>
					<li>MCRBotLevelVariable3</li>
					<li>MCRBotLevelVariable4</li>
					<li>MCRBotLevelVariable5</li>
					<li>MCRBotLevelVariable6</li>
					<li>MCRBotLevelVariable7</li>
				</keys>
			</li>
			<li Class="XmlExtensions.Setting.Gap"><spacing>8</spacing></li>
			<!-- Bots Level Slider -->
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable1</key>
				<label>Medicine Level: {MCRBotLevelVariable1}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable2</key>
				<label>Cooking Level: {MCRBotLevelVariable2}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable3</key>
				<label>Plants Level: {MCRBotLevelVariable3}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable4</key>
				<label>Construction Level: {MCRBotLevelVariable4}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable5</key>
				<label>Mining Level: {MCRBotLevelVariable5}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable6</key>
				<label>Crafting Level: {MCRBotLevelVariable6}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotLevelVariable7</key>
				<label>Intellectual Level: {MCRBotLevelVariable7}</label>
				<min>1</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>Changes the skillDef field on all bots from 20 to something else.\nNote: All existing bots in a save will be affected.</text>
				<tKey>MCRBotLevelVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.Text">
				<text>Bot Features</text>
				<anchor>Middle</anchor>
				<tKey>MCRSkillLevelSettingsTitle</tKey>
			</li>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.ResetSettings">
				<label>Reset Bot Feature Settings</label>
				<confirm>false</confirm>
				<keys>
					<li>MCRBotSpeedVariable</li>
					<li>MCRHaulerCapacityVariable</li>
					<li>MCRBotFlammabilityVariable</li>
					<li>MCRBotWorkSpeedGlobalVariable</li>
					<li>MCRBotSharpArmorVariable</li>
					<li>MCRBotBluntArmorVariable</li>
					<li>MCRBotHeatArmorVariable</li>
				</keys>
			</li>
			<li Class="XmlExtensions.Setting.Gap"><spacing>10</spacing></li>
			<li Class="XmlExtensions.Setting.Numeric">
				<key>MCRBotSpeedVariable</key>
				<label>Bot Speed</label>
				<defaultValue>5</defaultValue>
				<min>1</min>
				<max>20</max>
			</li>
			<li Class="XmlExtensions.Setting.Gap"><spacing>8</spacing></li>
			<li Class="XmlExtensions.Setting.Numeric">
				<key>MCRHaulerCapacityVariable</key>
				<label>Hauler Carrying Capacity</label>
				<defaultValue>400</defaultValue>
				<min>200</min>
				<max>2000</max>
			</li>
			<li Class="XmlExtensions.Setting.Gap"><spacing>6</spacing></li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>Bot body size cuts value in half. So 400 x 0.5 = 200 real Carrying Capacity</text>
				<tKey>MCRHaulerCapacityVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.Gap"><spacing>2</spacing></li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotFlammabilityVariable</key>
				<label>Flammability: {MCRBotFlammabilityVariable}</label>
				<min>0</min>
				<max>1</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>1 = 100% Flammability</text>
				<tKey>MCRBotFlammabilityVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotWorkSpeedGlobalVariable</key>
				<label>Global Work Speed: {MCRBotWorkSpeedGlobalVariable}</label>
				<min>0.1</min>
				<max>10</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>1 = 100% Work Speed</text>
				<tKey>MCRBotWorkSpeedGlobalVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotSharpArmorVariable</key>
				<label>Sharp Armor: {MCRBotSharpArmorVariable}</label>
				<min>0</min>
				<max>2</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>1 = 100% Armor against Sharp Damage</text>
				<tKey>MCRBotSharpArmorVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotBluntArmorVariable</key>
				<label>Blunt Armor: {MCRBotBluntArmorVariable}</label>
				<min>0</min>
				<max>2</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>1 = 100% Armor against Blunt Damage</text>
				<tKey>MCRBotBluntArmorVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotHeatArmorVariable</key>
				<label>Heat Armor: {MCRBotHeatArmorVariable}</label>
				<min>0</min>
				<max>2</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>1 = 100% Armor against Heat Damage</text>
				<tKey>MCRBotHeatArmorVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.Text">
				<text>Bot Station Settings</text>
				<anchor>Middle</anchor>
				<tKey>MCRSkillLevelSettingsTitle</tKey>
			</li>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.ResetSettings">
				<label>Reset Bot Station Settings</label>
				<confirm>false</confirm>
				<keys>
					<li>MCRSellPriceFactorVariable</li>
					<li>MCRStationCraftingSkillRequirementVariable</li>
					<li>MCRStationRechargeEfficiencyVariable</li>
					<li>MCRStationPowerConsumptionVariable</li>
				</keys>
			</li>
			<li Class="XmlExtensions.Setting.Gap"><spacing>8</spacing></li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRSellPriceFactorVariable</key>
				<label>Sell Price Factor: {MCRSellPriceFactorVariable}</label>
				<min>0</min>
				<max>2</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRStationCraftingSkillRequirementVariable</key>
				<label>Crafting Skill Requirement: {MCRStationCraftingSkillRequirementVariable}</label>
				<min>0</min>
				<max>20</max>
				<decimals>0</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRStationRechargeEfficiencyVariable</key>
				<label>Recharge Efficiency: {MCRStationRechargeEfficiencyVariable}</label>
				<min>0.1</min>
				<max>10</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Numeric">
				<key>MCRStationPowerConsumptionVariable</key>
				<label>Power Consumption</label>
				<defaultValue>250</defaultValue>
				<min>10</min>
				<max>1000</max>
			</li>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.Text">
				<text>Bot Graphic Settings</text>
				<anchor>Middle</anchor>
				<tKey>MCRGraphicSettingsTitle</tKey>
			</li>
			<li Class="XmlExtensions.Setting.GapLine"/>
			<li Class="XmlExtensions.Setting.ResetSettings">
				<label>Reset Bot Graphic Settings</label>
				<confirm>false</confirm>
				<keys>
					<li>MCRBotDrawSizeVariable</li>
					<li>MCRStationDrawSizeVariable</li>
				</keys>
			</li>
			<li Class="XmlExtensions.Setting.Gap"><spacing>8</spacing></li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRBotDrawSizeVariable</key>
				<label>Bot Draw Size: {MCRBotDrawSizeVariable}</label>
				<min>0.01</min>
				<max>3</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.Slider">
				<key>MCRStationDrawSizeVariable</key>
				<label>Station Draw Size: {MCRStationDrawSizeVariable}</label>
				<min>0.01</min>
				<max>3</max>
				<decimals>2</decimals>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"><color>(163,177,188)</color></li>
			<li Class="XmlExtensions.Setting.Text">
				<text>These affect the size of the bot and its base station. It's recommended to keep the bot within 0.10 of the station to match its docked size.</text>
				<tKey>MCRBotDrawSizeVariableDesc</tKey>
			</li>
			<li Class="XmlExtensions.Setting.SetColor"/>
			<li Class="XmlExtensions.Setting.Gap"><spacing>10</spacing></li>
			<li Class="XmlExtensions.Setting.ResetSettings">
				<label>Reset All Settings</label>
				<confirm>true</confirm>
			</li>
		</settings>
	</XmlExtensions.SettingsMenuDef>
</Defs>
