<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<!--
		Overwrote whole Misc Robots base structure so it has the entire base abstract. Check file CR_Base_Misc_Robots_Overwrite.xml
		Only need minor changes going forward.
	-->
	<!-- ======================= Base Structure ======================= -->
	<ThingDef Abstract="True" Name="AIRobot_Bot" ParentName="Base_X2_AIRobot" Class="AIRobot.X2_ThingDef_AIRobot">
		<robotSkills>
			<li><skillDef>Medicine</skillDef><level>20</level><passion>Minor</passion></li>
			<li><skillDef>Cooking</skillDef><level>20</level><passion>Minor</passion></li>
			<li><skillDef>Plants</skillDef><level>20</level><passion>Minor</passion></li>
			<li><skillDef>Construction</skillDef><level>20</level><passion>Minor</passion></li>
			<li><skillDef>Mining</skillDef><level>20</level><passion>Minor</passion></li>
			<li><skillDef>Crafting</skillDef><level>20</level><passion>Minor</passion></li>
			<li><skillDef>Intellectual</skillDef><level>20</level><passion>Minor</passion></li>
		</robotSkills>
	</ThingDef>

	<!-- ======================= Bots ======================= -->
	<ThingDef ParentName="AIRobot_Bot"  Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_GardenerBot</defName>
		<label>Gardener Bot</label>
		<description>A robot for gardening work (like cutting trees). It can also do cooking.</description>
		<race>
			<mechEnabledWorkTypes>
				<li>Cooking</li>
				<li>Growing</li>
				<li>PlantCutting</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Cooking</workTypeDef><priority>3</priority></li>
			<li><workTypeDef>Growing</workTypeDef><priority>2</priority></li>
			<li><workTypeDef>PlantCutting</workTypeDef><priority>1</priority></li>
		</robotWorkTypes>
		<destroyedDef>AIRobot_GardenerBot_disabled</destroyedDef>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Bot"  Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_CraftingBot</defName>
		<label>Crafting Bot</label>
		<description>A robot for crafting (smithing/tailoring/crafting).</description>
		<race>
			<mechEnabledWorkTypes>
				<li>Smithing</li>
				<li>Tailoring</li>
				<li>Crafting</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Smithing</workTypeDef><priority>2</priority></li>
			<li><workTypeDef>Tailoring</workTypeDef><priority>3</priority></li>
			<li><workTypeDef>Crafting</workTypeDef><priority>1</priority></li>
		</robotWorkTypes>
		<destroyedDef>AIRobot_CraftingBot_disabled</destroyedDef>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Bot"  Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_MiningBot</defName>
		<label>Mining Bot</label>
		<description>A robot for mining.</description>
		<race>
			<mechEnabledWorkTypes>
				<li>Mining</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Mining</workTypeDef><priority>3</priority></li>
		</robotWorkTypes>
		<destroyedDef>AIRobot_MiningBot_disabled</destroyedDef>
	</ThingDef>
	
	<ThingDef ParentName="AIRobot_Bot"  Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_ConstructionBot</defName>
		<label>Construction Bot</label>
		<description>A robot for constructing and repairing.</description>
		<race>
			<mechEnabledWorkTypes>
				<li>Construction</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Construction</workTypeDef><priority>3</priority></li>
		</robotWorkTypes>
		<destroyedDef>AIRobot_ConstructionBot_disabled</destroyedDef>
	</ThingDef>

	<ThingDef ParentName="AIRobot_Bot"  Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_MedBot</defName>
		<label>Med Bot</label>
		<description>A robot for feeding and tending to patients, treating wounds and doing surgery.</description>
		<race>
			<mechEnabledWorkTypes>
				<li>Doctor</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Doctor</workTypeDef><priority>3</priority></li>
		</robotWorkTypes>
		<destroyedDef>AIRobot_MedBot_disabled</destroyedDef>
	</ThingDef>
</Defs>


