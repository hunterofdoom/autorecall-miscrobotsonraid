<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <RecipeDef>
    <defName>CleanerBotProduction</defName>
    <label>Make Cleaner Bot</label>
    <description>Build a Cleaner Bot.</description>
    <jobString>Botting</jobString>
    <workAmount>10000</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Smelt</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>250</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <products>
      <AIRobot_RechargeStation_Cleaner>1</AIRobot_RechargeStation_Cleaner>
    </products>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
		<li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
		<recipeUsers>
			<li>TableMachining</li>
		</recipeUsers>
  </RecipeDef>
 
