<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<!--
		Overwritting entire base stations and bots to improve efficiency.
		It was taking too many patches to fix and is better for restructuring.
		Plus this allows for easier XML Extentions patching.
	-->
	<!-- ========================= Replacing Charging Stations and Abstracts  ========================= -->
	<ThingDef Abstract="True" Name="Base_X2_AIRobotRechargeStation" Class="AIRobot.X2_ThingDef_AIRobot_Building_RechargeStation">
		<thingClass>AIRobot.X2_Building_AIRobotRechargeStation</thingClass>
		<description>This station comes equipped with a specialized robot.</description>
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>0.95</drawSize>
			<damageData>
				<rect>(0.05,0.05,0.95,0.95)</rect>
			</damageData>
		</graphicData>
		<secondaryGraphicPath>Things/Building/AIRobot_RechargeStation/AIRobotRechargeStation_Empty1</secondaryGraphicPath>
		<drawerType>MapMeshAndRealTime</drawerType>
		<castEdgeShadows>True</castEdgeShadows>
		<category>Building</category>
		<altitudeLayer>Building</altitudeLayer>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<passability>Standable</passability>
		<pathCost>70</pathCost>
		<selectable>true</selectable>
		<useHitPoints>True</useHitPoints>
		<size>(1,1)</size>
		<minifiedDef>AIRobot_MinifiedRechargeStation</minifiedDef>
		<thingCategories><li>BuildingsFurniture</li></thingCategories>
		<fillPercent>0.25</fillPercent>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Beauty>0</Beauty>
			<SellPriceFactor>0.30</SellPriceFactor>
			<Mass>8</Mass> <!-- Real Roomba station only 5kg -->
			<Flammability>1.0</Flammability>
		</statBases>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<repairEffect>Repair</repairEffect>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<filthLeaving>Filth_RubbleBuilding</filthLeaving>
		<tradeNeverStack>true</tradeNeverStack>
		<stackLimit>1</stackLimit>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
			<skillRequirements><Crafting>9</Crafting></skillRequirements>
			<researchPrerequisites><li>Fabrication</li></researchPrerequisites>
			<recipeUsers><li>FabricationBench</li></recipeUsers>
		</recipeMaker>
		<robotRepairCosts> <!-- Each item must be greater than one or it'll be ignored. -->
			<Steel>25</Steel>
			<Plasteel>4</Plasteel>
			<ComponentIndustrial>1</ComponentIndustrial> <!-- Left here encase the above issue gets fixed -->
		</robotRepairCosts>
		<tickerType>Normal</tickerType>
		<tradeTags>
			<li>Robots</li>
			<li>Exotic</li>
			<li>ExoticMisc</li>
		</tradeTags>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>250</basePowerConsumption>
				<transmitsPower>false</transmitsPower>
			</li>
		</comps>
		<rechargeEfficiency>1.0</rechargeEfficiency>
	</ThingDef>
	
	<ThingDef ParentName="Base_X2_AIRobotRechargeStation" Class="AIRobot.X2_ThingDef_AIRobot_Building_RechargeStation">
		<defName>AIRobot_RechargeStation_Hauler</defName>
		<label>Hauler Base Station</label>
		<graphicData>
			<texPath>Things/Building/AIRobot_RechargeStation/AIRobotRechargeStation_HBot</texPath>
		</graphicData>
		<statBases>
			<WorkToMake>20000</WorkToMake>
			<MarketValue>1500</MarketValue>
		</statBases>
		<costList>
			<Steel>120</Steel>
			<Plasteel>20</Plasteel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<secondaryGraphicPath>Things/Building/AIRobot_RechargeStation/AIRobotRechargeStation_Empty</secondaryGraphicPath>
		<spawnThingDef>AIRobot_Hauler</spawnThingDef>
	</ThingDef>
	
	<ThingDef ParentName="Base_X2_AIRobotRechargeStation" Class="AIRobot.X2_ThingDef_AIRobot_Building_RechargeStation">
		<defName>AIRobot_RechargeStation_Cleaner</defName>
		<label>Cleaner Base Station</label>
		<graphicData>
			<texPath>Things/Building/AIRobot_RechargeStation/AIRobotRechargeStation_CBot</texPath>
		</graphicData>
		<statBases>
			<WorkToMake>10000</WorkToMake>
			<MarketValue>800</MarketValue>
		</statBases>
		<costList>
			<Steel>100</Steel>
			<Plasteel>20</Plasteel>
			<ComponentIndustrial>4</ComponentIndustrial>
		</costList>
		<spawnThingDef>AIRobot_Cleaner</spawnThingDef>
	</ThingDef>
	<!-- ========================= Replacing Bots and Abstracts ========================= -->
	<ThingDef Abstract="True" Name="Base_X2_AIRobot" Class="AIRobot.X2_ThingDef_AIRobot">
		<thingClass>AIRobot.X2_AIRobot</thingClass>
		<uiIconPath>Things/Pawn/Humanlike/UI/IconHuman</uiIconPath>
		<category>Pawn</category>
		<selectable>true</selectable>
		<tickerType>Normal</tickerType>
		<altitudeLayer>Pawn</altitudeLayer>
		<allowLearning>false</allowLearning>
		<useHitPoints>false</useHitPoints>
		<hasTooltip>true</hasTooltip>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<statBases>
			<Mass>8</Mass> <!-- Real Roomba station only 5kg -->
			<MoveSpeed>5</MoveSpeed>
			<CarryingCapacity>200</CarryingCapacity> <!-- equates to 100 because body size -->
			<MarketValue>10</MarketValue>
			<Flammability>1.0</Flammability>
			<PsychicSensitivity>0</PsychicSensitivity>
			<ToxicResistance>1</ToxicResistance>
			<ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
			<WorkSpeedGlobal>1</WorkSpeedGlobal>
			<ComfyTemperatureMin>-100</ComfyTemperatureMin>
			<ComfyTemperatureMax>100</ComfyTemperatureMax>
			<ArmorRating_Sharp>0.12</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.08</ArmorRating_Blunt>
			<ArmorRating_Heat>0.20</ArmorRating_Heat>
			<LeatherAmount>0</LeatherAmount>
			<MeatAmount>0</MeatAmount>
			<FilthRate>0</FilthRate>
		</statBases>
		<receivesSignals>false</receivesSignals>
		<inspectorTabs>
			<li>ITab_Pawn_Health</li>
			<li>ITab_Pawn_Needs</li>
			<li>ITab_Pawn_Gear</li>
		</inspectorTabs>
		<comps>
			<li><compClass>CompAttachBase</compClass></li>
		</comps>
		<drawGUIOverlay>true</drawGUIOverlay>
		<race>
			<body>AIRobot</body>
			<renderTree>Misc</renderTree>
			<thinkTreeMain>X2_AIRobot</thinkTreeMain>
			<thinkTreeConstant>X2_AIRobotConstant</thinkTreeConstant>
			<fleshType>Mechanoid</fleshType>
			<foodType>None</foodType>
			<intelligence>ToolUser</intelligence>
			<makesFootprints>false</makesFootprints>
			<nameCategory>HumanStandard</nameCategory>
			<wildness>0.1</wildness>
			<mateMtbHours>0</mateMtbHours>
			<baseBodySize>0.5</baseBodySize>
			<baseHungerRate>0.5</baseHungerRate>
			<baseHealthScale>0.5</baseHealthScale>
			<ageGenerationCurve>
				<points>
					<li>(0,0)</li>
					<li>(1,100)</li>
					<li>(5,50)</li>
					<li>(20,0)</li>
				</points>
			</ageGenerationCurve>
			<lifeExpectancy>5</lifeExpectancy>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_MechanoidBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_MechanoidBash_Miss</soundMeleeMiss>
		</race>
		<recipes></recipes>
		<costList>
			<Steel>35</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<tools>
			<li>
				<label>left manipulator</label>
				<capacities><li>Blunt</li></capacities>
				<power>4</power>
				<cooldownTime>1.6</cooldownTime>
				<linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
				<chanceFactor>1.0</chanceFactor>
			</li>
			<li>
				<label>right manipulator</label>
				<capacities><li>Cut</li></capacities>
				<power>4</power>
				<cooldownTime>1.6</cooldownTime>
				<linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
				<chanceFactor>0.8</chanceFactor>
			</li>
			<li>
				<label>head</label>
				<capacities><li>Blunt</li></capacities>
				<power>3</power>
				<cooldownTime>2.5</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
		<butcherProducts>
			<Steel>5</Steel>
		</butcherProducts>
	</ThingDef>
	
	<ThingDef ParentName="Base_X2_AIRobot" Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_Hauler</defName>
		<label>HaulingBot</label>
		<description>A hauling robot.</description>
		<statBases><CarryingCapacity>400</CarryingCapacity></statBases>
		<race>
			<mechEnabledWorkTypes>
				<li>Hauling</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Hauling</workTypeDef><priority>1</priority></li>
		</robotWorkTypes>
	</ThingDef>
	
	<ThingDef ParentName="Base_X2_AIRobot" Class="AIRobot.X2_ThingDef_AIRobot">
		<defName>AIRobot_Cleaner</defName>
		<label>CleaningBot</label>
		<description>A cleaning robot.</description>
		<race>
			<mechEnabledWorkTypes>
				<li>Cleaning</li>
			</mechEnabledWorkTypes>
		</race>
		<robotWorkTypes>
			<li><workTypeDef>Cleaning</workTypeDef><priority>1</priority></li>
		</robotWorkTypes>
		<robotSkills>
			<li><skillDef>Plants</skillDef><level>6</level><passion>Minor</passion></li>
		</robotSkills>
	</ThingDef>
</Defs>