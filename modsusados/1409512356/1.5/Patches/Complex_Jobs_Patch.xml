<?xml version="1.0" encoding="utf-8" ?>

<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods><li>[FSF] Complex Jobs</li></mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_GardenerBot"]/race/mechEnabledWorkTypes</xpath>
					<value>
						<li>FSFHarvesting</li>
						<li>FSFButcher</li>
					</value>
				</li>
				<li Class="PatchOperationConditional">		
					<xpath>/Defs/WorkTypeDef[defName="FSFPruning"]</xpath>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName = "AIRobot_GardenerBot"]/race/mechEnabledWorkTypes</xpath>
						<value><li>FSFPruning</li></value>
					</match>
				</li>
				<!-- Complex Jobs has this for 1.5. Adding would conflict.
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_GardenerBot"]/robotWorkTypes</xpath>
					<value>
						<li><workTypeDef>FSFHarvesting</workTypeDef><priority>2</priority></li>
						<li><workTypeDef>FSFButcher</workTypeDef><priority>3</priority></li>
					</value>
				</li>-->
				<!-- Complex Jobs has this for 1.5. Adding would conflict.
				<li Class="PatchOperationConditional">		
					<xpath>/Defs/WorkTypeDef[defName="FSFPruning"]</xpath>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName = "AIRobot_GardenerBot"]/robotWorkTypes</xpath>
						<value>
							<li><workTypeDef>FSFPruning</workTypeDef><priority>1</priority></li>
						</value>
					</match>
				</li>-->
			
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_ConstructionBot"]/race/mechEnabledWorkTypes</xpath>
					<value>
						<li>FSFDeconstruct</li>
						<li>FSFRepair</li>
					</value>
				</li>
				<li Class="PatchOperationConditional">		
					<xpath>/Defs/WorkTypeDef[defName="FSFSmoothing"]</xpath>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName = "AIRobot_ConstructionBot"]/race/mechEnabledWorkTypes</xpath>
						<value><li>FSFSmoothing</li></value>
					</match>
				</li>
				<!-- Complex Jobs has this for 1.5. Adding would conflict.
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_ConstructionBot"]/robotWorkTypes</xpath>
					<value>
						<li><workTypeDef>FSFDeconstruct</workTypeDef><priority>3</priority></li>
						<li><workTypeDef>FSFRepair</workTypeDef><priority>3</priority></li>
					</value>
				</li>-->
				<!-- Complex Jobs has this for 1.5. Adding would conflict.
				<li Class="PatchOperationConditional">		
					<xpath>/Defs/WorkTypeDef[defName="FSFSmoothing"]</xpath>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName = "AIRobot_ConstructionBot"]/robotWorkTypes</xpath>
						<value>
							<li><workTypeDef>FSFSmoothing</workTypeDef><priority>1</priority></li>
						</value>
					</match>
				</li>-->
			
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_CraftingBot"]/race/mechEnabledWorkTypes</xpath>
					<value>
						<li>FSFDrugs</li>
						<li>FSFMachining</li>
						<li>FSFRefining</li>
						<li>FSFSmelt</li>
						<li>FSFStoneCut</li>
						<li>FSFFabrication</li>
					</value>
				</li>
				<li Class="PatchOperationConditional">		
					<xpath>/Defs/WorkTypeDef[defName="FSFMechanoids"]</xpath>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName = "AIRobot_CraftingBot"]/race/mechEnabledWorkTypes</xpath>
						<value><li>FSFMechanoids</li></value>
					</match>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_CraftingBot"]/robotWorkTypes</xpath>
					<value>
						<li><workTypeDef>FSFDrugs</workTypeDef><priority>3</priority></li>
						<!-- Complex Jobs has this for 1.5. Adding would conflict. <li><workTypeDef>FSFMachining</workTypeDef><priority>3</priority></li> -->
						<li><workTypeDef>FSFRefining</workTypeDef><priority>3</priority></li>
						<li><workTypeDef>FSFSmelt</workTypeDef><priority>3</priority></li>
						<li><workTypeDef>FSFStoneCut</workTypeDef><priority>3</priority></li>
						<!-- Complex Jobs has this for 1.5. Adding would conflict. <li><workTypeDef>FSFFabrication</workTypeDef><priority>3</priority></li> -->
					</value>
				</li>
				<!-- Complex Jobs has this for 1.5. Adding would conflict.
				<li Class="PatchOperationConditional">		
					<xpath>/Defs/WorkTypeDef[defName="FSFMechanoids"]</xpath>
					<match Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName = "AIRobot_CraftingBot"]/robotWorkTypes</xpath>
						<value>
							<li><workTypeDef>FSFMechanoids</workTypeDef><priority>1</priority></li>
						</value>
					</match>
				</li>-->
				
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_MiningBot"]/race/mechEnabledWorkTypes</xpath>
					<value><li>FSFDrilling</li></value>
				</li>
				<!-- Complex Jobs has this for 1.5. Adding would conflict.
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_MiningBot"]/robotWorkTypes</xpath>
					<value>
						<li><workTypeDef>FSFDrilling</workTypeDef><priority>3</priority></li>
					</value>
				</li>-->
				
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_MedBot"]/race/mechEnabledWorkTypes</xpath>
					<value>
						<li>FSFSurgeon</li>
						<li>FSFNurse</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName = "AIRobot_MedBot"]/robotWorkTypes</xpath>
					<value>
						<li><workTypeDef>FSFSurgeon</workTypeDef><priority>3</priority></li>
						<li><workTypeDef>FSFNurse</workTypeDef><priority>3</priority></li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>